            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"isbn\": \"9781449373320\",\n  \"price\": {\n    \"amount\": 650000,\n    \"currency\": \"VND\"\n  },\n  \"stock\": 20,\n  \"category_id\": 1,\n  \"authors\": [\n    {\n      \"author_id\": 2,\n      \"role\": \"lead\"\n    }\n  ]\n}"
            },
            "url": {
