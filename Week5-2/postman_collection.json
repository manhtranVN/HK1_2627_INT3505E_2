    "name": "Week 5 - Bookstore API (Pagination, Filtering, Sorting)",
    "description": "Postman Collection hoàn chỉnh cho Bài tập 2 - Tuần 5: Data Modeling and Resource Design.\nBao gồm: Offset pagination, Cursor pagination, Filter ?genre, Sort multi-key, JSON Schema validation, Sub-resources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Offset Pagination",
      "item": [
        {
          "name": "GET /api/v1/books (Offset - Trang 1: offset=0, limit=5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?strategy=offset&offset=0&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
                {"key": "strategy", "value": "offset"},
                {"key": "offset", "value": "0"},
                {"key": "limit", "value": "5"}
              ]
            }
          }
        },
        {
          "name": "GET /api/v1/books (Offset - Trang 2: offset=5, limit=5)",
          "request": {
            "method": "GET",
            "header": [],
