# Database Connection URL (PostgreSQL in Docker/Production, SQLite in local Dev)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DB_URL=sqlite:///product_api.db

# Flask Application Secret Key
SECRET_KEY=development-secret-key-replace-in-production-32chars

# Application Configuration Class: product_api.config.DefaultConfig | ProductionConfig
APP_CONFIG=product_api.config.DefaultConfig

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Connection Pool Settings (For Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

